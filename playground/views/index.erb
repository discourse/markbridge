<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>Markbridge Playground</title>
    <link rel="icon" type="image/svg+xml" href="/assets/markbridge-icon.svg">
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Markbridge playground, start page">
          <img class="brand-mark" src="/assets/markbridge-icon.svg" alt="" width="24" height="24">
          <span class="brand-name">markbridge</span>
          <span class="brand-sub">playground</span>
        </a>

        <div id="format-switch" class="segmented" role="radiogroup" aria-label="Input format"></div>

        <span class="spacer"></span>

        <button id="examples-button" class="button" type="button" aria-haspopup="dialog">
          Examples <kbd id="examples-shortcut">Ctrl K</kbd>
        </button>
        <button id="site-button" class="button" type="button" popovertarget="site-popover">
          Site <span id="site-changed" class="dot" hidden title="Not the defaults"></span>
        </button>
      </header>

      <main id="panes" class="panes">
        <section class="pane pane-input" aria-label="Input">
          <div class="pane-bar">
            <span class="pane-label">Input</span>
            <span id="source-name" class="source-name"></span>
            <button id="reset-button" class="link-button" type="button" hidden>Reset</button>
            <span class="spacer"></span>
            <span id="format-hint" class="format-hint" hidden>
              Looks like <span id="format-hint-name"></span>
              <button id="format-hint-switch" class="link-button" type="button">Switch</button>
            </span>
            <button id="open-button" class="link-button" type="button" title="Open a file. Dropping one on the input works too.">Open file</button>
            <button id="share-button" class="link-button" type="button" title="Copy a link to this input">Copy link</button>
            <input id="file-input" type="file" hidden>
          </div>
          <textarea
            id="source-input"
            class="source-input"
            spellcheck="false"
            autocapitalize="off"
            autocomplete="off"
            aria-label="Markup to convert"
            placeholder="Paste or type markup here, drop a file, or pick an example."
          ></textarea>
        </section>

        <div id="splitter" class="splitter" role="separator" aria-orientation="vertical" aria-label="Resize the panes" tabindex="0"></div>

        <section class="pane pane-output" aria-label="Output">
          <div class="pane-bar">
            <nav id="view-tabs" class="tabs" role="tablist" aria-label="Output"></nav>
            <span class="spacer"></span>
            <span id="view-actions" class="view-actions"></span>
          </div>

          <div id="view-markdown" class="view code-view" role="tabpanel" tabindex="0"></div>
          <div id="view-preview" class="view preview-view" role="tabpanel" hidden>
            <iframe id="preview-frame" class="preview-frame" title="Cooked preview" sandbox="allow-popups"></iframe>
            <div id="preview-html" class="code-view" tabindex="0" hidden></div>
            <div id="preview-note" class="empty-state" hidden></div>
          </div>
          <div id="view-ast" class="view ast-view" role="tabpanel" tabindex="0" hidden></div>
          <div id="view-error" class="view error-view" role="alert" hidden></div>
        </section>
      </main>

      <footer class="statusbar">
        <button id="issues-button" class="issues-button" type="button" popovertarget="issues-popover" hidden></button>
        <span id="issues-none" class="status-quiet"></span>
        <span class="spacer"></span>
        <span id="stats" class="status-quiet"></span>
      </footer>
    </div>

    <div id="site-popover" class="popover" popover>
      <p class="popover-title">Target site</p>
      <p class="popover-text">The plugins of the Discourse site the Markdown is for. They are the <code>features:</code> of the renderer.</p>
      <label class="option">
        <input type="checkbox" data-option="spoiler">
        <span><b>spoiler-alert</b><small>Spoilers as <code>[spoiler]</code>, otherwise their content</small></span>
      </label>
      <label class="option">
        <input type="checkbox" data-option="bbcode">
        <span><b>discourse-bbcode</b><small>Colors and sizes as BBCode, otherwise their text</small></span>
      </label>
      <p class="popover-title">Pipeline</p>
      <label class="option">
        <input type="checkbox" data-option="normalize">
        <span><b>Normalize the AST</b><small>Move out what Markdown cannot nest, before rendering</small></span>
      </label>
      <button id="site-reset" class="link-button" type="button">Back to the defaults</button>
    </div>

    <div id="issues-popover" class="popover popover-issues" popover></div>

    <dialog id="examples-dialog" class="picker" aria-label="Examples">
      <input id="examples-search" class="picker-search" type="search" placeholder="Search examples, also by a tag or a word in them" autocomplete="off" spellcheck="false">
      <div id="examples-list" class="picker-list" role="listbox" aria-label="Examples"></div>
      <div class="picker-foot"><kbd>↑</kbd><kbd>↓</kbd> to move <kbd>Enter</kbd> to open <kbd>Esc</kbd> to close</div>
    </dialog>

    <div id="toast" class="toast" role="status" hidden></div>

    <script id="playground-data" type="application/json"><%= data_json.gsub("<", "\\u003c") %></script>
    <script src="/assets/app.js" defer></script>
  </body>
</html>
