#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the renderer round-trip checks over more cases than the specs do:
# every adjacency pair instead of a sample, and as many structure seeds
# as asked for. The same seeds also build trees that the normalizer has
# to repair first (see NormalizerRepairChecker), and trees that are
# written as HTML and go through the HTML parser (HtmlRoundTripChecker). Known bugs (spec/support/round_trip_known_bugs.rb) are
# skipped, and a known bug that passes is reported, as in the specs.
#
#   bin/fuzz-render                           # every pair and 300 seeds
#   bin/fuzz-render --only pairs
#   bin/fuzz-render --only repairs --seeds 3000   # trees the normalizer repairs
#   bin/fuzz-render --only html --seeds 3000      # trees written as HTML
#   bin/fuzz-render --seeds 3000 --only trees --output tmp/fuzz-render
#   bin/fuzz-render --sample 5000             # a random subset of the pairs
#   bin/fuzz-render --sample 5000 --sample-seed 7   # another subset
#   bin/fuzz-render --all                     # run the known bugs too
#   bin/fuzz-render --engine all              # cook with the Discourse engine
#
# With --engine the cases cook with Discourse's own engine, on the given
# profile of DiscourseEngineCooker (bin/discourse-engine builds it), the
# structure seeds get attributed quotes, and the known bugs come from
# the engine lists.
#
# Every failure is shrunk, and the failures whose shrunk trees have the
# same shape (see AstDump.signature) are one group: one report, the AST,
# its Markdown and the cooked HTML, and the cases it stands for. With
# --output the reports go to <dir>/failures.txt and the summary to
# <dir>/summary.txt. The exit status is 1 when a case fails that is not
# a known bug, or when a known bug passes.

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "bundler/setup"
require "fileutils"
require "optparse"
require "markbridge/all"
require_relative "../spec/support/ast_generator"
require_relative "../spec/support/adjacency_generator"
require_relative "../spec/support/round_trip_checker"
require_relative "../spec/support/broken_ast_generator"
require_relative "../spec/support/normalizer_repair_checker"
require_relative "../spec/support/html_round_trip_checker"
require_relative "../spec/support/round_trip_known_bugs"
require_relative "../spec/support/discourse_engine_cooker"

class FuzzRender
  # +build+ turns a case into its document, +checker+ checks it.
  Family = Data.define(:name, :list, :cases, :build, :checker)
  Result = Data.define(:family, :id, :checks, :reason)

  FAMILIES = %w[pairs blocks trees repairs html].freeze

  def initialize(argv)
    @seeds = 300
    @only = FAMILIES
    @sample = nil
    @sample_seed = AdjacencyGenerator::DEFAULT_SAMPLE_SEED
    @output = nil
    @all = false
    @engine = nil
    parse(argv)
    @checker =
      if @engine
        cooker = DiscourseEngineCooker.profile(@engine)
        RoundTripChecker.new(features: cooker.features, cooker:)
      else
        RoundTripChecker.new
      end
    @failed = []
    @stale = []
    @known = []
    # signature => [report, ids, checks]
    @groups = {}
  end

  def run
    cooker = @engine ? DiscourseEngineCooker : MarkdownItCooker
    reason = cooker::SKIP_REASON || cooker.missing
    abort "bin/fuzz-render: #{reason}" if reason

    @families = families
    @families.each { |family| run_family(family) }
    finish
  end

  private

  def parse(argv)
    OptionParser
      .new do |opts|
        opts.banner = "usage: bin/fuzz-render [options]"
        opts.on("--seeds N", Integer, "structure seeds to run (default: 300)") { |n| @seeds = n }
        opts.on(
          "--only FAMILY",
          FAMILIES,
          "run only pairs, blocks, trees, repairs or html",
        ) { |family| @only = [family] }
        opts.on("--sample N", Integer, "run N random pairs instead of all of them") do |n|
          @sample = n
        end
        opts.on(
          "--sample-seed N",
          Integer,
          "the seed that picks the sample (default: #{@sample_seed})",
        ) { |n| @sample_seed = n }
        opts.on("--output DIR", "write failures.txt and summary.txt to DIR") { |dir| @output = dir }
        opts.on("--all", "run the known bugs like every other case") { @all = true }
        opts.on(
          "--engine PROFILE",
          DiscourseEngineCooker::PROFILES.keys.map(&:to_s),
          "cook with the Discourse engine on this profile (stock, all or none)",
        ) { |profile| @engine = profile.to_sym }
      end
      .parse!(argv)
  end

  def families
    list = []
    from_case = ->(kase) { kase.document }
    if @only.include?("pairs")
      cases =
        if @sample
          AdjacencyGenerator.inline_sample(@sample, seed: @sample_seed)
        else
          AdjacencyGenerator.inline_cases
        end
      list << family("pairs", known_bugs(:adjacency), cases, from_case)
    end
    if @only.include?("blocks")
      list << family("blocks", known_bugs(:adjacency), AdjacencyGenerator.block_cases, from_case)
    end
    return list unless @seeds.positive?

    if @only.include?("trees")
      build = ->(seed) { AstGenerator.new(seed, attributed_quotes: !@engine.nil?).document }
      list << family("trees", known_bugs(:structure), (1..@seeds), build)
    end
    if @only.include?("repairs")
      build = ->(seed) { BrokenAstGenerator.new(seed).document }
      # The known repairs are listed for markdown-it only.
      known = @engine ? nil : :repair
      list << family("repairs", known, (1..@seeds), build, NormalizerRepairChecker.new(@checker))
    end
    # The HTML round trip compares with plain HTML, so it cooks with
    # markdown-it only: the engine adds what the input never had.
    if @only.include?("html") && !@engine
      build = ->(seed) { AstHtmlWriter.lower(AstGenerator.new(seed).document) }
      list << family("html", :html, (1..@seeds), build, HtmlRoundTripChecker.new)
    end
    list
  end

  def family(name, list, cases, build, checker = @checker)
    Family.new(name:, list:, cases:, build:, checker:)
  end

  # The known-bug list of the cooker, see RoundTripKnownBugs::LISTS.
  def known_bugs(list)
    @engine ? :"#{list}_engine" : list
  end

  def run_family(family)
    started = Time.now
    family.cases.each_with_index do |kase, index|
      run_case(family, kase)
      progress(family, index + 1, started) if ((index + 1) % 5000).zero?
    end
    progress(family, family.cases.size, started)
  end

  # @param kase [AdjacencyGenerator::InlineCase, AdjacencyGenerator::BlockCase, Integer]
  def run_case(family, kase)
    id = kase.is_a?(Integer) ? kase : kase.id
    reason = (RoundTripKnownBugs.reason(family.list, id) if family.list && !@all)
    checks = family.checker.failures(family.build.call(kase)).map(&:check)

    if checks.empty?
      @stale << Result.new(family: family.name, id:, checks:, reason:) if reason
    elsif reason
      @known << Result.new(family: family.name, id:, checks:, reason:)
    else
      @failed << Result.new(family: family.name, id:, checks:, reason: nil)
      group(family, id, family.build.call(kase), checks)
    end
  end

  # Shrinks the document and files it under the shape of what is left.
  # The first case of a shape gets the report, and its checks name the
  # group in the summary.
  def group(family, id, document, checks)
    before = document.descendants.size
    family.checker.shrink(document)
    signature = "#{family.name}\n#{AstDump.signature(document)}"
    group = @groups[signature]
    if group
      group[1] << "#{family.name} #{id}"
    else
      label = "#{family.name} #{id}, shrunk from #{before} to #{document.descendants.size} nodes"
      @groups[signature] = [
        family.checker.report(document, label:),
        ["#{family.name} #{id}"],
        checks,
      ]
    end
  end

  def progress(family, done, started)
    elapsed = (Time.now - started).round
    warn "#{family.name}: #{done}/#{family.cases.size} in #{elapsed}s, #{@failed.size} failed"
  end

  def finish
    reports =
      @groups
        .values
        .sort_by { |_, ids| -ids.size }
        .map do |report, ids|
          "#{ids.size} cases: #{ids.first(10).join(", ")}#{", ..." if ids.size > 10}\n\n#{report}"
        end
        .join("\n\n#{"=" * 72}\n\n")
    summary = summary_text

    if @output
      FileUtils.mkdir_p(@output)
      File.write(File.join(@output, "failures.txt"), reports)
      File.write(File.join(@output, "summary.txt"), summary)
    else
      puts reports unless reports.empty?
    end
    puts summary

    exit(@failed.empty? && @stale.empty? ? 0 : 1)
  end

  def summary_text
    lines = ["family         cases   failed    known"]
    @families.each do |family|
      failed = @failed.count { |result| result.family == family.name }
      known = @known.count { |result| result.family == family.name }
      lines << format("%-12s %8d %8d %8d", family.name, family.cases.size, failed, known)
    end

    unless @failed.empty?
      lines << "" << "failed checks:"
      @failed
        .flat_map(&:checks)
        .tally
        .sort_by { |check, count| [-count, check] }
        .each { |check, count| lines << format("  %-10s %6d", check, count) }
      lines << "" << "distinct failures: #{@groups.size}"
      @groups
        .values
        .sort_by { |_, ids| -ids.size }
        .each do |_, ids, checks|
          lines << "  #{ids.size} cases, e.g. #{ids.first}: #{checks.join(", ")}"
        end
      lines << "" << "failed cases:"
      @failed.each do |result|
        lines << "  #{result.family} #{result.id} [#{result.checks.join(", ")}]"
      end
    end

    unless @stale.empty?
      lines << "" << "known bugs that pass now, remove their entries:"
      @stale.each { |result| lines << "  #{result.family} #{result.id}: #{result.reason}" }
    end

    lines.join("\n")
  end
end

FuzzRender.new(ARGV).run
